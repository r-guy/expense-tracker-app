# Copy this file to .env and fill in your own values.

EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here
EXCHANGE_RATE_API_BASE=https://v6.exchangerate-api.com/v6

# One or more backend URLs, tried in order (comma-separated).
# - Android emulator:            http://10.0.2.2:8000
# - Physical device + USB:       run `adb reverse tcp:8000 tcp:8000`, then http://127.0.0.1:8000
# - Physical device + Wi-Fi:     http://<YOUR_PC_LAN_IP>:8000
CURRENCY_BACKEND_BASE_URL=http://10.0.2.2:8000

# Neon Auth (Managed Better Auth) base URL from the Neon project branch.
# Public endpoint, not a secret. Get it with: neon neon-auth status
NEON_AUTH_BASE_URL=https://<your-auth-host>/<db>/auth

